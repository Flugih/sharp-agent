# Настройки Sharp Agent. Провайдер выбирается в окне «Настройки» или в меню модели
# Через кого отвечает агент: tooken, chatgpt или groq
AGENT_PROVIDER=tooken
# Tooken Club: впишите свой ключ с https://tooken.club/dashboard
TOOKEN_API_KEY=
TOOKEN_BASE_URL=https://tooken.club/v1
TOOKEN_MODEL=claude-sonnet-5-5
# Модель, которой агент рисует картинки (всегда через Tooken Club)
TOOKEN_IMAGE_MODEL=gpt-image-2
# Сила рассуждения: low, medium или high (пусто — как решит модель)
TOOKEN_REASONING_EFFORT=
# ChatGPT: вход — кнопкой «Продолжить с ChatGPT» в настройках, он хранится в auth\chatgpt.json
CHATGPT_MODEL=gpt-6.1-sol
# low, medium, high, xhigh, max или ultra — если модель это поддерживает
CHATGPT_REASONING_EFFORT=
# Groq: ключ создаётся на https://console.groq.com/keys; он же нужен для голосового ввода (микрофон в поле ввода)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=
# Рабочая папка агента (относительный путь — от папки программы)
AGENT_WORKDIR=workspace
# true — агент работает ТОЛЬКО внутри папки программы (команды PowerShell/cmd отключаются)
AGENT_SANDBOX=false
AGENT_USE_SUBAGENTS=false
# Свои лимиты расхода в миллионах токенов баланса Tooken Club (пусто — без лимита)
# AGENT_DAY_LIMIT_MLN=5
# AGENT_MONTH_LIMIT_MLN=50
# TOOKEN_MAX_TOKENS=8192
