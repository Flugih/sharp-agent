<Window x:Class="SharpAgent.Ui.CompactChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SharpAgent.Ui"
        Title="Sharp Agent · Компактный режим" Width="360" SizeToContent="Height" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="14" Topmost="True" ShowInTaskbar="False"
        UseLayoutRounding="True" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="8,5,8,9">
        <Border x:Name="TranscriptCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="14,4,8,4"
                Visibility="Collapsed" MouseLeftButtonDown="Pill_MouseLeftButtonDown">
            <ScrollViewer x:Name="TranscriptScroll" MaxHeight="238" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="Transcript"/>
                    <ui:Shimmer x:Name="StatusText" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" Margin="0,6,4,6" AutomationProperties.LiveSetting="Polite"/>
                    <TextBox x:Name="StreamText" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" Padding="0"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                             Visibility="Collapsed" Margin="0,5,4,6" AutomationProperties.Name="Ответ агента"/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource DangerText}"
                               Visibility="Collapsed" Margin="0,8,4,8" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <ContentControl x:Name="QuestionSlot" Margin="0,7,0,0" Visibility="Collapsed" HorizontalContentAlignment="Stretch"/>
        <Border Background="{DynamicResource ComposerBg}" BorderBrush="{DynamicResource ComposerLine}" BorderThickness="1" CornerRadius="20" MinHeight="46" Margin="0,7,0,0" Padding="11,6,6,6"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="3,0,4,0" VerticalAlignment="Center">
                    <TextBox x:Name="PromptInput" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0"
                             CaretBrush="{DynamicResource Text}" SelectionBrush="{DynamicResource Accent}" Padding="0,4"
                             AcceptsReturn="True" MaxHeight="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="PromptInput_TextChanged" PreviewKeyDown="PromptInput_PreviewKeyDown"
                             AutomationProperties.Name="Сообщение агенту"/>
                    <TextBlock Text="Сообщение агенту…" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=PromptInput}" Value=""/>
                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptInput}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="0,0,4,0"
                            ToolTip="Открыть полное окно" AutomationProperties.Name="Открыть полное окно" Click="FullWindow_Click"/>
                    <Button x:Name="ActionButton" Style="{StaticResource SendButton}"
                            Content="&#xE74A;" ToolTip="Отправить" AutomationProperties.Name="Отправить" Click="ActionButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
