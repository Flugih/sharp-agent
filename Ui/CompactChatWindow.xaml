<Window x:Class="SharpAgent.Ui.CompactChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sharp Agent · Компактный режим" Width="360" SizeToContent="Height" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" Topmost="True" ShowInTaskbar="False"
        UseLayoutRounding="True" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="#F01E1F22"/>
            <Setter Property="BorderBrush" Value="#54FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="26"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="8,5,8,9">
        <Border Style="{StaticResource Pill}" MinHeight="54" Padding="15,9" MouseLeftButtonDown="Pill_MouseLeftButtonDown">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PromptTitle" Text="Sharp Agent" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusText" Text="Готов к запросу" Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
        <Border x:Name="TranscriptCard" Style="{StaticResource Pill}" CornerRadius="17" Margin="0,7,0,0" Padding="13,1,8,2"
                Visibility="Collapsed">
            <ScrollViewer x:Name="TranscriptScroll" MaxHeight="238" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="Transcript"/>
                    <TextBox x:Name="StreamText" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" Padding="0"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                             Visibility="Collapsed" Margin="0,5,4,6" AutomationProperties.Name="Ответ модели"/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource DangerText}"
                               Visibility="Collapsed" Margin="0,8,4,8" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <ContentControl x:Name="QuestionSlot" Margin="0,7,0,0" Visibility="Collapsed" HorizontalContentAlignment="Stretch"/>
        <Border Style="{StaticResource Pill}" MinHeight="46" Margin="0,7,0,0" Padding="11,4,6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="3,0,4,0" VerticalAlignment="Center">
                    <TextBox x:Name="PromptInput" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0"
                             FontFamily="Segoe UI" FontSize="13" CaretBrush="{StaticResource Text}" Padding="0,4"
                             AcceptsReturn="True" MaxHeight="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="PromptInput_TextChanged" PreviewKeyDown="PromptInput_PreviewKeyDown"
                             AutomationProperties.Name="Сообщение агенту"/>
                    <TextBlock x:Name="PromptHint" Text="Сообщение агенту…" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ActionButton" Style="{StaticResource IconButton}" Width="31" Height="31" FontSize="14"
                            Content="&#xE74A;" ToolTip="Отправить" AutomationProperties.Name="Отправить" Click="ActionButton_Click"/>
                    <Border Width="1" Height="17" Background="#38FFFFFF" Margin="3,0"/>
                    <Button Style="{StaticResource IconButton}" Width="31" Height="31" FontSize="13" Content="&#xE8A7;"
                            ToolTip="Открыть полное окно" AutomationProperties.Name="Открыть полное окно" Click="FullWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
