                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <Button x:Name="TestKeyButton" Content="{ui:Localized 'Проверить API-ключ', 'Check API key'}" VerticalAlignment="Top" Click="TestKey_Click" ToolTip="{ui:Localized 'Запросить список моделей у выбранного провайдера', 'Request the model list from the selected provider'}" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"/>
