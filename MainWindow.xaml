<Window x:Class="SharpAgent.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SharpAgent.Ui" xmlns:core="clr-namespace:SharpAgent.Core" Title="Sharp Agent" Height="800" Width="1200" MinHeight="480" MinWidth="560" Icon="Assets/app.ico" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" AllowDrop="True" Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged" Activated="Window_Activated" SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_PreviewKeyDown" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver" PreviewDragLeave="Window_PreviewDragLeave" PreviewDrop="Window_PreviewDrop">

    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness="0" не значение по умолчанию: без него текст теряет ClearType -->
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="WorkArea" Grid.Row="1" Grid.Column="1" ClipToBounds="True" SizeChanged="WorkArea_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ChatModePicker" Panel.ZIndex="5" HorizontalAlignment="Center" CornerRadius="17" Background="{DynamicResource ChatModeTrack}" Margin="0,8,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.28"/>
                    </Border.Effect>
                    <Grid Width="222" Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style x:Key="ChatModeTab" TargetType="ToggleButton" BasedOn="{StaticResource BoxBase}">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource ChatModeText}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusPill}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Border x:Name="Shadow" Background="{DynamicResource ChatModeShadow}" CornerRadius="17" Margin="0,0,-2,0" Visibility="Collapsed"/>
                                                <Border x:Name="Selected" Background="{DynamicResource ChatModeSelected}" CornerRadius="17" Visibility="Collapsed"/>
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Grid.Column" Value="1">
                                                    <Setter TargetName="Shadow" Property="Margin" Value="-2,0,0,0"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Shadow" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Selected" Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <ToggleButton x:Name="ConversationModeButton" Style="{StaticResource ChatModeTab}" Content="{ui:Localized 'Чат', 'Chat'}" Click="ChatMode_Click"/>
                        <ToggleButton x:Name="WorkModeButton" Grid.Column="1" Style="{StaticResource ChatModeTab}" Content="{ui:Localized 'Работа', 'Work'}" IsChecked="True" Click="ChatMode_Click"/>
                    </Grid>
                </Border>
                <ToggleButton x:Name="TemporaryChatButton" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Margin="0,8,16,8" ToolTip="{ui:Localized 'Временный чат', 'Temporary chat'}" AutomationProperties.Name="{ui:Localized 'Временный чат', 'Temporary chat'}" Click="TemporaryChat_Click">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
                            <Setter Property="Background" Value="{DynamicResource ChatModeTrack}"/>
                            <Setter Property="Border.CornerRadius" Value="17"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ToggleButton.Style>
                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 3,8 H 17 M 5,8 L 6.5,3.5 H 13.5 L 15,8 M 8.5,13 H 11.5 M 8.5,13 A 2.75,2.75 0 1 1 3,13 A 2.75,2.75 0 1 1 8.5,13 M 17,13 A 2.75,2.75 0 1 1 11.5,13 A 2.75,2.75 0 1 1 17,13"/>
                </ToggleButton>
                <Button x:Name="SaveTemporaryChatButton" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Margin="0,8,16,8" Cursor="Hand" Visibility="Collapsed" ToolTip="{ui:Localized 'Сохранить временный чат', 'Save temporary chat'}" AutomationProperties.Name="{ui:Localized 'Сохранить временный чат', 'Save temporary chat'}" Click="SaveTemporaryChat_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Background" Value="{DynamicResource ChatModeTrack}"/>
                            <Setter Property="Border.CornerRadius" Value="17"/>
                        </Style>
                    </Button.Style>
                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M 4,2 L 12,2 L 12,14 L 8,11 L 4,14 Z"/>
                </Button>
                <Grid Grid.RowSpan="3">
                    <ScrollViewer x:Name="ChatScroll" Template="{StaticResource ChatScrollTemplate}" VerticalScrollBarVisibility="Auto" Focusable="False" ScrollChanged="ChatScroll_ScrollChanged" SizeChanged="Composer_SizeChanged" PreviewMouseLeftButtonDown="ChatScroll_PreviewMouseLeftButtonDown">
                        <StackPanel x:Name="ChatContent" MaxWidth="736" Margin="24,58,24,24">
                            <StackPanel x:Name="ChatPages">
                                <StackPanel x:Name="ChatPanel"/>
                            </StackPanel>
                            <Button x:Name="ChangesPill" Style="{StaticResource PillButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="{ui:Localized 'Открыть последние изменения справа', 'Open latest changes in side panel'}" AutomationProperties.Name="{ui:Localized 'Открыть последние изменения справа', 'Open latest changes in side panel'}" Click="ChangesPill_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel x:Name="ChatStickyHost" Panel.ZIndex="5" VerticalAlignment="Top" MaxWidth="736" Margin="24,58,24,4" Visibility="Collapsed" SizeChanged="ChatStickyHost_SizeChanged" PreviewMouseWheel="ChatStickyHost_PreviewMouseWheel">
                        <ui:Shimmer x:Name="ChatStickyTitle" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="ChatStickyPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                    <Button x:Name="ScrollDownButton" Style="{StaticResource FloatButton}" Content="&#xE74B;" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.Name="{ui:Localized 'К последнему сообщению', 'Jump to latest message'}" Click="ScrollDown_Click"/>
                </Grid>

                <Grid x:Name="ComposerHost" Grid.Row="2" ClipToBounds="True">
                <StackPanel x:Name="ComposerPanel" MaxWidth="736" Margin="24,0,24,19" SizeChanged="ComposerPanel_SizeChanged">
                    <TextBlock x:Name="ComposerIntro" HorizontalAlignment="Center" Foreground="{DynamicResource TextSoft}" FontSize="25" FontWeight="Normal" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,0,0,40"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=Banner}" Value="Visible">
                                        <Setter Property="Margin" Value="0,0,0,16"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border x:Name="Banner" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12,12,12" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="BannerAction" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="BannerAction_Click"/>
                            <TextBlock x:Name="BannerIcon" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BannerTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="BannerText" FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ContentControl x:Name="QuestionHost" Visibility="Collapsed" Margin="0,0,0,8"/>

                    <!-- The strip runs under the box's rounded top edge -->
                    <Border Background="{DynamicResource ComposerStrip}" CornerRadius="12,12,0,0" Margin="13,0,13,-18" Padding="6,0,6,18">
                        <DockPanel>
                            <StackPanel x:Name="WorkContextPanel" DockPanel.Dock="Top" Orientation="Horizontal" Height="39">
                                <Button x:Name="ModePill" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Text}" Click="ModePill_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ModeIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE7F8;" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ModeText" Text="{ui:Localized 'Весь ПК', 'Full computer access'}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FolderButton" Style="{StaticResource GhostButton}" Foreground="{DynamicResource TextDim}" Margin="4,0,0,0" Click="FolderButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE8B7;" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FolderText" Text="workspace" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{ui:Localized 'Выбрать другую папку…', 'Choose another folder…'}" Click="FolderButton_Click"/>
                                            <MenuItem Header="{ui:Localized 'Открыть в Проводнике', 'Open in File Explorer'}" InputGestureText="Ctrl+Shift+O" Click="OpenWorkDir_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                            <WrapPanel x:Name="NextActionPanel" Margin="6,0,0,4" Visibility="Collapsed" AutomationProperties.Name="{ui:Localized 'Следующие действия', 'Next actions'}"/>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Border x:Name="ComposerBackdrop" Background="{DynamicResource Bg}" IsHitTestVisible="False"/>
                        <Border x:Name="Composer" Background="{DynamicResource ComposerBg}" BorderBrush="{DynamicResource ComposerLine}" BorderThickness="1" CornerRadius="18" MinHeight="98" Padding="8,12,8,8" SizeChanged="Composer_SizeChanged">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <WrapPanel x:Name="AttachPanel" Margin="4,0,4,6" Visibility="Collapsed"/>

                                <Grid Grid.Row="1" Margin="4,0">
                                    <ui:ComposerBox x:Name="InputBox" Style="{StaticResource ComposerInput}" MinHeight="36" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{ui:Localized 'Сообщение агенту', 'Message the agent'}" PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged" CommandManager.PreviewCanExecute="InputBox_PreviewCanExecute" CommandManager.PreviewExecuted="InputBox_PreviewExecuted"/>
                                    <TextBlock x:Name="InputHint" IsHitTestVisible="False" Foreground="{DynamicResource TextDim}" Margin="5,0,0,0" Text="{ui:Localized 'Работайте в Sharp Agent', 'Work with Sharp Agent'}"/>
                                    <DockPanel x:Name="VoicePanel" MinHeight="36" Visibility="Collapsed">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Margin="0,0,4,0" ToolTip="{ui:Localized 'Отменить голосовой ввод (Esc)', 'Cancel voice input (Esc)'}" AutomationProperties.Name="{ui:Localized 'Отменить голосовой ввод', 'Cancel voice input'}" Click="VoiceCancel_Click"/>
                                            <Button x:Name="VoiceDoneButton" Style="{StaticResource SendButton}" Content="&#xE73E;" ToolTip="{ui:Localized 'Готово: распознать речь и вставить текст в поле', 'Transcribe and insert'}" AutomationProperties.Name="{ui:Localized 'Готово, распознать речь', 'Finish recording and transcribe'}" Click="VoiceDone_Click"/>
                                        </StackPanel>
                                        <Border x:Name="VoiceMark" Width="14" Height="14"/>
                                        <TextBlock x:Name="VoiceTime" Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center" Margin="10,0,12,0" AutomationProperties.LiveSetting="Polite" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{StaticResource FocusPill}"/>
                                        <ui:VoiceWave x:Name="VoiceWave" Height="28" Margin="0,0,12,0"/>
                                    </DockPanel>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AttachButton" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="{ui:Localized 'Прикрепить файлы (Ctrl+O). Правая кнопка — прикрепить папку', 'Attach files (Ctrl+O). Right-click to attach a folder'}" AutomationProperties.Name="{ui:Localized 'Прикрепить файлы', 'Attach files'}" Click="Attach_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{ui:Localized 'Прикрепить файлы…', 'Attach files…'}" InputGestureText="Ctrl+O" Click="Attach_Click"/>
                                                <MenuItem Header="{ui:Localized 'Прикрепить папку…', 'Attach a folder…'}" Click="AttachFolder_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <ToggleButton x:Name="ConfirmToggle" Grid.Column="1" Style="{StaticResource BoxBase}" Height="32" Padding="8,0" Margin="4,0,0,0" IsChecked="True" Checked="ConfirmToggle_Checked" Unchecked="ConfirmToggle_Unchecked" AutomationProperties.Name="{ui:Localized 'Подтверждения опасных действий', 'Confirm risky actions'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ConfirmIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xEA18;" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ConfirmLabel" Text="{ui:Localized 'Подтверждения', 'Confirmations'}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button x:Name="ModelButton" Grid.Column="2" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Margin="4,0" AutomationProperties.Name="{ui:Localized 'Модель и усилие', 'Model and reasoning effort'}" Click="ModelButton_Click">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="12" Margin="6,1,0,0" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ModelEffortText" DockPanel.Dock="Right" Foreground="{DynamicResource TextDim}" Margin="6,0,0,0" MaxWidth="114" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock x:Name="ModelNameText" Foreground="{DynamicResource Text}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Button>
                                    <Button x:Name="MicButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE720;" Margin="0,0,4,0" ToolTip="{ui:Localized 'Голосовой ввод: текст появится в поле, но не отправится сам', 'Dictate a draft without sending it'}" AutomationProperties.Name="{ui:Localized 'Голосовой ввод', 'Voice input'}" Click="Mic_Click"/>
                                    <Grid Grid.Column="4">
                                        <Button x:Name="SendButton" Style="{StaticResource SendButton}" Content="&#xE74A;" ToolTip="{ui:Localized 'Отправить (Enter). Новая строка — Shift+Enter', 'Send (Enter). New line: Shift+Enter'}" AutomationProperties.Name="{ui:Localized 'Отправить', 'Send'}" IsEnabled="False" Click="Send_Click"/>
                                        <Button x:Name="StopButton" Style="{StaticResource SendButton}" ToolTip="{ui:Localized 'Остановить агента (Esc)', 'Stop agent (Esc)'}" AutomationProperties.Name="{ui:Localized 'Остановить агента', 'Stop agent'}" Click="Stop_Click" Visibility="Collapsed">
                                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                        <ContentControl x:Name="ComposerLoadingStatus" Style="{StaticResource ComposerLoading}" VerticalAlignment="Bottom" Margin="8,0,8,-17"/>
                    </Grid>
                </StackPanel>
                </Grid>

                <DockPanel x:Name="RightPane" Grid.RowSpan="3" Grid.Column="1" Panel.ZIndex="10" Visibility="Collapsed">
                    <Border x:Name="PreviewPane" Visibility="Collapsed" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Height="44" Margin="16,0,8,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static ui:Glyphs.Cancel}" ToolTip="{ui:Localized 'Закрыть (Esc)', 'Close (Esc)'}" AutomationProperties.Name="{ui:Localized 'Закрыть просмотр', 'Close preview'}" Click="PreviewClose_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="{ui:Localized 'Открыть в программе', 'Open in default app'}" AutomationProperties.Name="{ui:Localized 'Открыть в программе', 'Open in default app'}" Click="PreviewOpen_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{ui:Localized 'Показать в папке', 'Show in folder'}" AutomationProperties.Name="{ui:Localized 'Показать в папке', 'Show in folder'}" Click="PreviewReveal_Click"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewPath" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <ContentControl x:Name="PreviewBody" Focusable="False" Margin="8,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </DockPanel>
                    </Border>
                </DockPanel>
                <GridSplitter x:Name="PreviewSplitter" Grid.RowSpan="3" Grid.Column="1" Panel.ZIndex="11" Width="6" HorizontalAlignment="Left" Background="Transparent" ResizeBehavior="PreviousAndCurrent" Visibility="Collapsed" ToolTip="{ui:Localized 'Изменить ширину панели', 'Resize panel'}" AutomationProperties.Name="{ui:Localized 'Изменить ширину панели', 'Resize panel'}" DragCompleted="PreviewSplitter_DragCompleted" KeyUp="PreviewSplitter_KeyUp"/>
                <Border x:Name="BrowserPane" Grid.RowSpan="3" Grid.Column="1" Panel.ZIndex="10" Visibility="Collapsed"
                        Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                    <Border.Resources>
                        <!-- A tab's close button shows on the current tab and on hover -->
                        <Style x:Key="BrowserTabClose" TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Margin" Value="4,0,0,0"/>
                            <Setter Property="Content" Value="{x:Static ui:Glyphs.Cancel}"/>
                            <Setter Property="ToolTip" Value="{ui:Localized 'Закрыть вкладку', 'Close tab'}"/>
                            <Setter Property="AutomationProperties.Name" Value="{ui:Localized 'Закрыть вкладку', 'Close tab'}"/>
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <DockPanel Height="44" Margin="8,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static ui:Glyphs.Cancel}" Click="BrowserClose_Click" ToolTip="{ui:Localized 'Закрыть браузер', 'Close browser'}" AutomationProperties.Name="{ui:Localized 'Закрыть браузер', 'Close browser'}"/>
                            <Button x:Name="BrowserExpand" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static ui:Glyphs.FullScreen}" Click="BrowserExpand_Click" ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{ui:Localized 'Развернуть браузер', 'Expand browser'}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel x:Name="BrowserTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Margin="2,0,0,0" Click="BrowserNew_Click" ToolTip="{ui:Localized 'Новая вкладка', 'New tab'}" AutomationProperties.Name="{ui:Localized 'Новая вкладка', 'New tab'}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                        <DockPanel x:Name="BrowserToolbar" Grid.Row="1" Margin="8,0,8,8">
                            <StackPanel x:Name="BrowserNavigation" Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BrowserBack" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="BrowserBack_Click" AutomationProperties.Name="{ui:Localized 'Назад', 'Back'}"/>
                                <Button x:Name="BrowserForward" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="BrowserForward_Click" AutomationProperties.Name="{ui:Localized 'Вперёд', 'Forward'}"/>
                                <Button Style="{StaticResource IconButton}" Content="{x:Static ui:Glyphs.Refresh}" Click="BrowserReload_Click" AutomationProperties.Name="{ui:Localized 'Обновить страницу', 'Reload page'}"/>
                            </StackPanel>
                            <Button x:Name="BrowserNetworkButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{x:Static ui:Glyphs.Globe}" Margin="0,0,8,0" Click="BrowserNetwork_Click" AutomationProperties.Name="{ui:Localized 'Настройки сети', 'Network settings'}"/>
                            <Grid>
                                <TextBox x:Name="BrowserAddress" Style="{StaticResource FieldTextBox}" KeyDown="BrowserAddress_KeyDown" AutomationProperties.Name="{ui:Localized 'Адрес или поисковый запрос', 'Address or search query'}"/>
                                <TextBlock Text="{ui:Localized 'Поиск или адрес сайта', 'Search or enter an address'}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0" Foreground="{DynamicResource TextDim}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=BrowserAddress}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <Grid x:Name="BrowserPages" Grid.Row="2">
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=SidebarShade}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=PictureOverlay}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=FlyoutLayer}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=SearchLayer}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=DropOverlay}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=DialogDim}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                            </Style.Triggers></Style></Grid.Style>
                        </Grid>
                        <StackPanel x:Name="BrowserErrorView" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Margin="16" Visibility="Collapsed">
                            <TextBlock Text="{x:Static ui:Glyphs.Globe}" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="BrowserError" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,16"/>
                            <Button Content="{ui:Localized 'Обновить страницу', 'Reload page'}" HorizontalAlignment="Center" Click="BrowserReload_Click" AutomationProperties.Name="{ui:Localized 'Обновить страницу', 'Reload page'}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="SubagentsWorkspace" Grid.RowSpan="3" Grid.Column="1" Panel.ZIndex="10" Visibility="Collapsed" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" AutomationProperties.Name="{ui:Localized 'Панель субагентов', 'Subagents panel'}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Height="44" Margin="16,0,8,0">
                            <Button x:Name="SubagentsCloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static ui:Glyphs.Cancel}" Click="SubagentsClose_Click" ToolTip="{ui:Localized 'Закрыть панель субагентов', 'Close subagents panel'}" AutomationProperties.Name="{ui:Localized 'Закрыть панель субагентов', 'Close subagents panel'}"/>
                            <Button x:Name="SubagentsExpandButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static ui:Glyphs.FullScreen}" Click="SubagentsExpand_Click" AutomationProperties.Name="{ui:Localized 'Развернуть на всё рабочее пространство', 'Expand to workspace'}"/>
                            <TextBlock Text="{x:Static ui:Glyphs.Plugin}" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{ui:Localized 'Субагенты', 'Subagents'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel x:Name="SubagentHeader" DockPanel.Dock="Top" Margin="8,0,16,8" Visibility="Collapsed">
                            <Button x:Name="SubagentBackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="0,0,8,0" Visibility="Collapsed" Click="SubagentBack_Click" ToolTip="{ui:Localized 'К списку субагентов', 'Back to subagents'}" AutomationProperties.Name="{ui:Localized 'К списку субагентов', 'Back to subagents'}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SubagentTitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SubagentModelText" Foreground="{DynamicResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer x:Name="SubagentsScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel MaxWidth="736" Margin="4,0,4,16">
                                <StackPanel x:Name="SubagentList"/>
                                <StackPanel x:Name="SubagentDetail" Margin="12,8,12,0" Visibility="Collapsed">
                                    <TextBlock Text="{ui:Localized 'Активность', 'Activity'}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                    <ContentControl x:Name="SubagentActivity" HorizontalContentAlignment="Stretch" Focusable="False"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2" Background="{DynamicResource ChromeBg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SidebarToggle" Style="{StaticResource IconButton}" Content="&#xE90C;" Width="28" Height="28" Margin="11,0,10,0" Visibility="{Binding Visibility, ElementName=WorkArea}" Click="SidebarToggle_Click"/>
                    <TextBlock Text="{ui:Localized 'Настройки', 'Settings'}" Style="{StaticResource TitleText}" Visibility="{Binding Visibility, ElementName=SettingsPage}"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Visibility, ElementName=WorkArea}">
                        <TextBlock x:Name="ChatTitleText" Text="{ui:Localized 'Новый чат', 'New chat'}" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="ChatMenuButton" Style="{StaticResource IconButton}" Content="&#xE70D;" Width="28" Height="28" FontSize="12" Margin="2,0,0,0" Visibility="Collapsed" ToolTip="{ui:Localized 'Действия с чатом', 'Chat actions'}" AutomationProperties.Name="{ui:Localized 'Действия с чатом', 'Chat actions'}" Click="ChatMenu_Click"/>
                        <Button x:Name="GitBranchButton" Style="{StaticResource PillButton}" Height="24" Margin="6,0,0,0" Padding="8,0" Visibility="Collapsed" Click="GitBranch_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextDim}" StrokeThickness="1.2" Data="M 3,4 A 1.5,1.5 0 1 1 3,1 A 1.5,1.5 0 1 1 3,4 M 3,12 A 1.5,1.5 0 1 1 3,9 A 1.5,1.5 0 1 1 3,12 M 10,4 A 1.5,1.5 0 1 1 10,1 A 1.5,1.5 0 1 1 10,4 M 3,4 V 9 M 10,4 C 10,8 3,5 3,9"/>
                                <TextBlock x:Name="GitBranchText" MaxWidth="122" Margin="5,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="9" Foreground="{DynamicResource TextDim}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Grid Visibility="{Binding Visibility, ElementName=WorkArea}">
                        <Button x:Name="SubagentsOpenButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="{ui:Localized 'Субагенты', 'Subagents'}" Visibility="Collapsed" Click="SubagentsOpen_Click" AutomationProperties.Name="{ui:Localized 'Открыть панель субагентов', 'Open subagents panel'}"/>
                    </Grid>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="{ui:Localized 'Свернуть', 'Minimize'}" Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="{ui:Localized 'Развернуть', 'Maximize'}" Click="Maximize_Click"/>
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" AutomationProperties.Name="{ui:Localized 'Закрыть окно', 'Close window'}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Border x:Name="SidebarShade" Grid.Row="1" Grid.Column="1" Background="{DynamicResource Shade}" Visibility="Collapsed" MouseLeftButtonDown="SidebarShade_MouseLeftButtonDown"/>

            <Border x:Name="Sidebar" Grid.Row="1" Width="240" HorizontalAlignment="Left" Background="{DynamicResource ChromeBg}">
                <Border.Resources>
                    <Style x:Key="SidebarItem" TargetType="Button" BasedOn="{StaticResource NavButton}">
                        <Setter Property="Margin" Value="0,0,0,1"/>
                    </Style>
                    <Style x:Key="SidebarIcon" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="SidebarLabel" TargetType="TextBlock">
                        <Setter Property="Margin" Value="10,0,0,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="8">
                        <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE721;" Cursor="Hand" VerticalAlignment="Center" ToolTip="{ui:Localized 'Поиск (Ctrl+K)', 'Search (Ctrl+K)'}" AutomationProperties.Name="{ui:Localized 'Поиск', 'Search'}" Click="Search_Click"/>
                        <Button x:Name="NewChatButton" Style="{StaticResource SidebarItem}" AutomationProperties.Name="{ui:Localized 'Новый чат', 'New chat'}" Click="NewChat_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE70F;"/>
                                <TextBlock x:Name="NewChatLabel" Style="{StaticResource SidebarLabel}" Text="{ui:Localized 'Новый чат', 'New chat'}" Foreground="{DynamicResource Text}"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <ScrollViewer x:Name="ChatListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0" Focusable="False" ScrollChanged="ChatListScroll_ScrollChanged">
                        <StackPanel x:Name="ChatList" Margin="8,0,4,8" KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="{ui:Localized 'Чаты', 'Chats'}" PreviewKeyDown="ChatList_PreviewKeyDown"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="8,0,8,8">
                        <Button x:Name="TrashButton" Style="{StaticResource SidebarItem}" Click="Trash_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE74D;"/>
                                <TextBlock x:Name="TrashLabel" Style="{StaticResource SidebarLabel}" Text="{ui:Localized 'Корзина', 'Trash'}"/>
                                <TextBlock x:Name="TrashCount" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BalanceButton" Style="{StaticResource SidebarItem}" ToolTip="{ui:Localized 'Баланс и расход (Ctrl+B)', 'Balance and usage (Ctrl+B)'}" Click="Balance_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xEC4A;"/>
                                <TextBlock x:Name="BalanceText" Style="{StaticResource SidebarLabel}" Text="{ui:Localized 'Баланс и расход', 'Balance and usage'}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource SidebarItem}" ToolTip="{ui:Localized 'Настройки (Ctrl+,)', 'Settings (Ctrl+,)'}" AutomationProperties.Name="{ui:Localized 'Настройки', 'Settings'}" Click="OpenSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE713;"/>
                                <TextBlock x:Name="SettingsLabel" Style="{StaticResource SidebarLabel}" Text="{ui:Localized 'Настройки', 'Settings'}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource SidebarItem}" ToolTip="{ui:Localized 'Другие команды (F10)', 'More actions (F10)'}" AutomationProperties.Name="{ui:Localized 'Другие команды', 'More actions'}" Click="More_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SidebarIcon}" Text="&#xE712;"/>
                                <TextBlock x:Name="MoreLabel" Style="{StaticResource SidebarLabel}" Text="{ui:Localized 'Ещё', 'More'}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MoreMenu">
                                    <MenuItem Header="{ui:Localized 'Браузер', 'Browser'}" Click="BrowserOpen_Click">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE774;"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{ui:Localized 'Компактный режим', 'Compact mode'}" Click="CompactMode_Click">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE73F;"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{ui:Localized 'Сочетания клавиш', 'Keyboard shortcuts'}" InputGestureText="F1" Click="Shortcuts_Click">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE765;"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{ui:Localized 'О программе', 'About'}" Click="About_Click">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE946;"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <Thumb x:Name="SidebarResize" Grid.RowSpan="3" HorizontalAlignment="Right" Width="7" Cursor="SizeWE" Focusable="True" Visibility="Collapsed" FocusVisualStyle="{StaticResource FocusInner}" ToolTip="{ui:Localized 'Потяните край или нажмите ← / →, чтобы изменить ширину', 'Drag the edge or press ← / → to resize'}" AutomationProperties.Name="{ui:Localized 'Изменить ширину списка чатов', 'Resize chat list'}" DragStarted="SidebarResize_DragStarted" DragDelta="SidebarResize_DragDelta" DragCompleted="SidebarResize_DragCompleted" PreviewKeyDown="SidebarResize_PreviewKeyDown">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <Border x:Name="Grip" Width="2" HorizontalAlignment="Right" Background="Transparent"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource TrackStrong}"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>

            <Grid x:Name="DropOverlay" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource Bg}" Opacity="0.92"/>
                <Rectangle Margin="16" RadiusX="16" RadiusY="16" Stroke="{DynamicResource TrackStrong}" StrokeThickness="2" StrokeDashArray="5 4"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE723;" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="{ui:Localized 'Отпустите, чтобы прикрепить', 'Drop to attach'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock x:Name="DropHint" Foreground="{DynamicResource TextMuted}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="SettingsPage" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Bg}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsNavColumn" Width="240"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style x:Key="SettingsNavItem" TargetType="Button" BasedOn="{StaticResource NavButton}">
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Margin" Value="0,0,0,3"/>
                    </Style>
                    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="ClipToBounds" Value="True"/>
                    </Style>
                    <!-- Rows draw the line above them; the card clips the first one -->
                    <Style x:Key="SettingsRow" TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                        <Setter Property="Margin" Value="0,-1,0,0"/>
                        <Setter Property="Padding" Value="16,12"/>
                        <Style.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                    <Style x:Key="RowText" TargetType="StackPanel">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,24,0"/>
                    </Style>
                    <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                        <Setter Property="Margin" Value="0,2,0,0"/>
                    </Style>
                    <Style x:Key="RowStatus" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                        <Setter Property="Margin" Value="0,8,0,0"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="RowDropdown" TargetType="Button" BasedOn="{StaticResource DropdownButton}">
                        <Setter Property="DockPanel.Dock" Value="Right"/>
                        <Setter Property="MinWidth" Value="200"/>
                        <Setter Property="MaxWidth" Value="280"/>
                    </Style>
                    <Style x:Key="RowField" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
                        <Setter Property="DockPanel.Dock" Value="Right"/>
                        <Setter Property="Width" Value="200"/>
                    </Style>
                </Grid.Resources>

                <Border Grid.RowSpan="2" Background="{DynamicResource ChromeBg}" Padding="8,12">
                    <StackPanel x:Name="SettingsNav" AutomationProperties.Name="{ui:Localized 'Разделы настроек', 'Settings sections'}">
                        <DockPanel Margin="0,0,0,12">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="{ui:Localized 'Вернуться к чату без сохранения (Esc)', 'Return to chat without saving (Esc)'}" AutomationProperties.Name="{ui:Localized 'Закрыть настройки', 'Close settings'}" Click="SettingsCancel_Click"/>
                            <TextBlock Style="{StaticResource PageTitle}" Text="{ui:Localized 'Настройки', 'Settings'}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Button Style="{StaticResource SettingsNavItem}" CommandParameter="SettingsGeneral" Click="SettingsNav_Click" AutomationProperties.Name="{ui:Localized 'Общие', 'General'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{ui:Localized 'Общие', 'General'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsNavItem}" CommandParameter="SettingsProviders" Click="SettingsNav_Click" AutomationProperties.Name="{ui:Localized 'Провайдеры', 'Providers'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE753;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{ui:Localized 'Провайдеры', 'Providers'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsNavItem}" CommandParameter="SettingsAgent" Click="SettingsNav_Click" AutomationProperties.Name="{ui:Localized 'Агент', 'Agent'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE99A;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{ui:Localized 'Агент', 'Agent'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsNavItem}" CommandParameter="SettingsNetwork" Click="SettingsNav_Click" AutomationProperties.Name="{ui:Localized 'Сеть', 'Network'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{ui:Localized 'Сеть', 'Network'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsNavItem}" CommandParameter="SettingsLimits" Click="SettingsNav_Click" AutomationProperties.Name="{ui:Localized 'Лимиты', 'Limits'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEC4A;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{ui:Localized 'Лимиты', 'Limits'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="32,28,32,24" Focusable="False">
                    <Grid x:Name="SettingsFields" MaxWidth="724" TextBoxBase.TextChanged="SettingsFields_TextChanged">
                        <StackPanel x:Name="SettingsGeneral">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{ui:Localized 'Оформление', 'Appearance'}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <Button x:Name="ThemeButton" Style="{StaticResource RowDropdown}" Click="ThemeButton_Click" AutomationProperties.Name="{ui:Localized 'Тема', 'Theme'}"/>
                                            <TextBlock Text="{ui:Localized 'Тема', 'Theme'}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <Button x:Name="LanguageButton" Style="{StaticResource RowDropdown}" Click="LanguageButton_Click"
                                                    AutomationProperties.Name="{ui:Localized 'Язык системы', 'System language'}"/>
                                            <TextBlock Text="{ui:Localized 'Язык системы', 'System language'}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="SettingsProviders" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{ui:Localized 'Провайдеры', 'Providers'}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <Button x:Name="ProviderButton" Style="{StaticResource RowDropdown}" Click="ProviderButton_Click" AutomationProperties.Name="{ui:Localized 'Провайдер', 'Provider'}"/>
                                            <StackPanel Style="{StaticResource RowText}">
                                                <TextBlock Text="{ui:Localized 'Провайдер', 'Provider'}"/>
                                                <TextBlock x:Name="ProviderKeysHint" Style="{StaticResource RowHint}">
                                                    <Hyperlink x:Name="ProviderKeysLink" RequestNavigate="KeyLink_RequestNavigate"><Run Text="{ui:Localized 'Открыть страницу ключей', 'Open API keys page'}"/></Hyperlink>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border x:Name="KeyPanel" Style="{StaticResource SettingsRow}">
                                        <StackPanel>
                                            <TextBlock x:Name="KeyLabel" Text="{ui:Localized 'API-ключ', 'API key'}"/>
                                            <DockPanel Margin="0,8,0,0">
                                                <ToggleButton x:Name="ShowKeyToggle" DockPanel.Dock="Right" Style="{StaticResource IconToggle}" Content="&#xE890;" Margin="8,0,0,0" ToolTip="{ui:Localized 'Показать или скрыть ключ', 'Show or hide API key'}" AutomationProperties.Name="{ui:Localized 'Показать ключ', 'Show API key'}" Checked="ShowKey_Changed" Unchecked="ShowKey_Changed"/>
                                                <Grid>
                                                    <PasswordBox x:Name="KeyPasswordBox" PasswordChanged="ConnectionFieldChanged" Style="{StaticResource FieldPasswordBox}" AutomationProperties.Name="{ui:Localized 'API-ключ', 'API key'}"/>
                                                    <TextBox x:Name="KeyTextBox" TextChanged="ConnectionFieldChanged" Style="{StaticResource FieldTextBox}" Visibility="Collapsed" AutomationProperties.Name="{ui:Localized 'API-ключ', 'API key'}"/>
                                                </Grid>
                                            </DockPanel>
                                            <TextBlock x:Name="KeyHint" Style="{StaticResource FieldHint}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ChatGptPanel" Style="{StaticResource SettingsRow}" Visibility="Collapsed">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="ChatGptAccountButton" Style="{StaticResource RowDropdown}" Visibility="Collapsed" Click="ChatGptAccountButton_Click"/>
                                                <StackPanel Style="{StaticResource RowText}">
                                                    <TextBlock Text="{ui:Localized 'Аккаунт ChatGPT', 'ChatGPT account'}"/>
                                                    <TextBlock x:Name="ChatGptPlan" Style="{StaticResource RowStatus}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="ChatGptSignInButton" Style="{StaticResource PrimaryButton}" Content="{ui:Localized 'Продолжить с ChatGPT', 'Continue with ChatGPT'}" Margin="0,0,8,0" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" Click="ChatGptSignIn_Click"/>
                                                <Button x:Name="ChatGptCancelButton" Content="{ui:Localized 'Отменить вход', 'Cancel sign-in'}" Visibility="Collapsed" Click="ChatGptCancel_Click"/>
                                                <Button x:Name="ChatGptSignOutButton" Content="{ui:Localized 'Выйти', 'Sign out'}" Visibility="Collapsed" AutomationProperties.Name="{ui:Localized 'Выйти из ChatGPT', 'Sign out of ChatGPT'}" Click="ChatGptSignOut_Click"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="ChatGptHint" Style="{StaticResource RowStatus}"/>
                                        </StackPanel>
                                    </Border>

