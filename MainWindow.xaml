                                        <StackPanel x:Name="VoiceKeyPanel" Margin="0,0,0,8">
                                            <TextBlock Text="{ui:Localized 'API-ключ Groq', 'Groq API key'}"/>
                                            <PasswordBox x:Name="VoiceKeyBox" Style="{StaticResource FieldPasswordBox}" Margin="0,8,0,0" AutomationProperties.Name="{ui:Localized 'API-ключ Groq для голосового ввода', 'Groq API key for voice input'}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FieldHint}" Margin="0">
                                            <Run x:Name="VoiceHint"/><Hyperlink Click="GroqKeysLink_Click"><Run Text="{ui:Localized 'Открыть страницу ключей', 'Open API keys page'}"/></Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="SettingsNetwork" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{ui:Localized 'Сеть', 'Network'}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <Button x:Name="NetworkModeButton" Style="{StaticResource RowDropdown}" Click="NetworkModeButton_Click" AutomationProperties.Name="{ui:Localized 'Подключение приложения', 'App connection'}"/>
                                            <StackPanel Style="{StaticResource RowText}">
                                                <TextBlock Text="{ui:Localized 'Подключение приложения', 'App connection'}"/>
                                                <TextBlock Style="{StaticResource RowHint}" Text="{ui:Localized 'Маршрут используют запросы Sharp Agent и команды с поддержкой переменных прокси. Внешний браузер использует свои сетевые настройки.', 'Sharp Agent and commands that support proxy variables use this route. External browsers use their own network settings.'}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <StackPanel x:Name="NetworkProxyFields" Visibility="Collapsed">
                                        <Border Style="{StaticResource SettingsRow}">
                                            <DockPanel>
                                                <Button x:Name="NetworkProxyType" Style="{StaticResource RowDropdown}" Click="NetworkProxyType_Click" AutomationProperties.Name="{ui:Localized 'Тип прокси', 'Proxy type'}"/>
                                                <TextBlock Text="{ui:Localized 'Тип прокси', 'Proxy type'}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <DockPanel>
                                                <TextBox x:Name="NetworkHost" Style="{StaticResource RowField}" TextChanged="ConnectionFieldChanged" AutomationProperties.Name="{ui:Localized 'Адрес прокси', 'Proxy address'}"/>
                                                <TextBlock Text="{ui:Localized 'Адрес сервера', 'Server address'}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <DockPanel>
                                                <TextBox x:Name="NetworkPort" Style="{StaticResource RowField}" TextChanged="ConnectionFieldChanged" AutomationProperties.Name="{ui:Localized 'Порт прокси', 'Proxy port'}"/>
                                                <TextBlock Text="{ui:Localized 'Порт', 'Port'}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <DockPanel>
                                                <TextBox x:Name="NetworkUser" Style="{StaticResource RowField}" TextChanged="ConnectionFieldChanged" AutomationProperties.Name="{ui:Localized 'Логин прокси', 'Proxy username'}"/>
                                                <StackPanel Style="{StaticResource RowText}">
                                                    <TextBlock Text="{ui:Localized 'Логин', 'Username'}"/>
                                                    <TextBlock Style="{StaticResource RowHint}" Text="{ui:Localized 'Логин и пароль нужны, только если прокси требует авторизацию.', 'A username and password are needed only for proxies that require authentication.'}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <DockPanel>
                                                <PasswordBox x:Name="NetworkPassword" DockPanel.Dock="Right" Width="200" Style="{StaticResource FieldPasswordBox}" PasswordChanged="ConnectionFieldChanged" AutomationProperties.Name="{ui:Localized 'Пароль прокси', 'Proxy password'}"/>
                                                <TextBlock Text="{ui:Localized 'Пароль', 'Password'}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel x:Name="NetworkVpnFields" Visibility="Collapsed">
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="{ui:Localized 'Ссылка подписки', 'Subscription URL'}"/>
                                                <DockPanel Margin="0,8,0,0">
                                                    <Button x:Name="NetworkImportButton" DockPanel.Dock="Right" Content="{ui:Localized 'Загрузить серверы', 'Load servers'}" Margin="8,0,0,0" Click="NetworkImport_Click"/>
                                                    <PasswordBox x:Name="NetworkSubscription" Style="{StaticResource FieldPasswordBox}" AutomationProperties.Name="{ui:Localized 'Ссылка подписки VPN', 'VPN subscription URL'}" PasswordChanged="NetworkSubscription_Changed"/>
                                                </DockPanel>
                                                <TextBlock x:Name="NetworkImportStatus" Style="{StaticResource RowStatus}" AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <DockPanel>
                                                <Button x:Name="NetworkVpnServer" Style="{StaticResource RowDropdown}" Click="NetworkVpnServer_Click" AutomationProperties.Name="{ui:Localized 'Выбрать сервер VPN', 'Choose a VPN server'}"/>
                                                <TextBlock Text="{ui:Localized 'Сервер VPN', 'VPN server'}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <StackPanel x:Name="NetworkEnginePicker">
                                                    <TextBlock Text="{ui:Localized 'Путь к sing-box.exe', 'Path to sing-box.exe'}"/>
                                                    <DockPanel Margin="0,8,0,0">
                                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{ui:Localized 'Выбрать…', 'Browse…'}" Click="NetworkBrowse_Click"/>
                                                        <TextBox x:Name="NetworkEngine" TextChanged="ConnectionFieldChanged" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="{ui:Localized 'Путь к sing-box.exe', 'Path to sing-box.exe'}"/>
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0">
                                                        <Run Text="{ui:Localized 'Подходит распакованная Windows-версия 1.12 или новее. ', 'Use an extracted Windows build of version 1.12 or later. '}"/><Hyperlink Click="NetworkDownload_Click"><Run Text="{ui:Localized 'Скачать sing-box', 'Download sing-box'}"/></Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock x:Name="NetworkEngineFound" Foreground="{DynamicResource Success}" Text="{ui:Localized 'sing-box.exe найден', 'sing-box.exe found'}" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <Button x:Name="NetworkTestButton" Content="{ui:Localized 'Проверить сетевой маршрут', 'Check network route'}" VerticalAlignment="Top" Click="NetworkTest_Click" ToolTip="{ui:Localized 'Проверить доступность API по выбранному маршруту запросом без ключа', 'Check whether the API is reachable over this route without an API key'}"/>
                                            <TextBlock x:Name="NetworkTestStatus" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FieldHint}" Text="{ui:Localized 'Настройки применяются после сохранения.', 'Settings take effect after saving.'}"/>
                        </StackPanel>
                        <StackPanel x:Name="SettingsAgent" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{ui:Localized 'Агент', 'Agent'}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <ToggleButton x:Name="AutoChatTitlesToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{ui:Localized 'Автоматически называть чаты', 'Automatically name chats'}"/>
                                            <StackPanel Style="{StaticResource RowText}">
                                                <TextBlock Text="{ui:Localized 'Автоматически называть чаты', 'Automatically name chats'}"/>
                                                <TextBlock Style="{StaticResource RowHint}" Text="{ui:Localized 'Если выключено, новый чат получает название из первого сообщения.', 'When off, new chats use their first message as the title.'}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <ToggleButton x:Name="SubagentsToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{ui:Localized 'Использовать субагентов', 'Use subagents'}"/>
                                            <StackPanel Style="{StaticResource RowText}">
                                                <TextBlock Text="{ui:Localized 'Использовать субагентов', 'Use subagents'}"/>
                                                <TextBlock Style="{StaticResource RowHint}" Text="{ui:Localized 'В быстром режиме агент поручает больше независимых проверок. В обычном режиме бюджет субагентов меньше.', 'Fast mode delegates more independent checks. Standard mode uses a smaller subagent budget.'}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <ToggleButton x:Name="ComputerUseToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" ToolTip="{ui:Localized 'Агент запускает программы, нажимает кнопки, вводит текст и проверяет работу приложений по дереву элементов и скриншотам', 'The agent launches apps, clicks controls, types, and checks results using the UI tree and screenshots'}" AutomationProperties.Name="{ui:Localized 'Управление компьютером', 'Computer use'}"/>
                                            <StackPanel Style="{StaticResource RowText}">
                                                <TextBlock Text="{ui:Localized 'Управление компьютером', 'Computer use'}"/>
                                                <TextBlock Style="{StaticResource RowHint}" Text="{ui:Localized 'Скриншоты расходуют много токенов: агент смотрит их, только когда дерева элементов недостаточно. В режиме песочницы недоступно.', 'The agent uses screenshots only when the UI tree is insufficient, since screenshots use many tokens. Unavailable in sandbox mode.'}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <StackPanel>
                                            <TextBlock Text="{ui:Localized 'Плагины', 'Plugins'}"/>
                                            <TextBlock x:Name="PluginsText" Style="{StaticResource RowHint}"/>
                                            <TextBlock Style="{StaticResource RowHint}">
                                                <Hyperlink Click="OpenPlugins_Click"><Run Text="{ui:Localized 'Открыть папку плагинов', 'Open plugins folder'}"/></Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <TextBox x:Name="MaxTokensBox" Style="{StaticResource RowField}" AutomationProperties.Name="{ui:Localized 'Токенов в одном ответе', 'Tokens per response'}"/>
                                            <StackPanel Style="{StaticResource RowText}">
                                                <TextBlock Text="{ui:Localized 'Токенов в одном ответе, не больше', 'Maximum tokens per response'}"/>
                                                <TextBlock Style="{StaticResource RowHint}" Text="{ui:Localized 'Пустое поле оставляет предел модели. Настройка действует для всех провайдеров, включая ChatGPT.', 'Leave blank to use the model limit. Applies to all providers, including ChatGPT.'}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="SettingsLimits" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{ui:Localized 'Лимиты расхода', 'Usage limits'}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <TextBox x:Name="DayLimitBox" Style="{StaticResource RowField}" AutomationProperties.Name="{ui:Localized 'Лимит в день, миллионов токенов', 'Daily limit, millions of tokens'}"/>
                                            <TextBlock Text="{ui:Localized 'В день, млн токенов', 'Per day, million tokens'}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRow}">
                                        <DockPanel>
                                            <TextBox x:Name="MonthLimitBox" Style="{StaticResource RowField}" AutomationProperties.Name="{ui:Localized 'Лимит в месяц, миллионов токенов', 'Monthly limit, millions of tokens'}"/>
                                            <TextBlock Text="{ui:Localized 'В месяц, млн токенов', 'Per month, million tokens'}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FieldHint}" Text="{ui:Localized 'Когда лимит исчерпан, агент останавливается и спрашивает, продолжать ли. Считаются токены баланса tooken.club по всему ключу, поэтому лимиты действуют только для Tooken Club. Пустое поле — без лимита.', 'The agent asks before continuing once a limit is reached. Limits apply only to Tooken Club and count all token usage for the key. Leave blank for no limit.'}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="32,12,32,16">
                    <StackPanel MaxWidth="724">
                        <TextBlock x:Name="SettingsError" Foreground="{DynamicResource DangerText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{ui:Localized 'Отмена', 'Cancel'}" Click="SettingsCancel_Click" AutomationProperties.Name="{ui:Localized 'Отмена', 'Cancel'}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="{ui:Localized 'Сохранить', 'Save'}" Margin="8,0,0,0" Click="SettingsSave_Click" AutomationProperties.Name="{ui:Localized 'Сохранить настройки', 'Save settings'}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="PictureOverlay" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Scrim}" MouseLeftButtonUp="PictureOverlay_MouseLeftButtonUp">
                <Image x:Name="PictureImage" Margin="48,20,48,64" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Button Style="{StaticResource FloatButton}" Width="36" Height="36" FontSize="12" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" ToolTip="{ui:Localized 'Закрыть (Esc)', 'Close (Esc)'}" AutomationProperties.Name="{ui:Localized 'Закрыть изображение', 'Close image'}" Click="PictureClose_Click"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,14" Orientation="Horizontal">
                    <!-- The scrim is dark in both themes, so the name sits on a raised chip to stay readable -->
                    <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Track}" BorderThickness="1" CornerRadius="18" Height="36" Padding="14,0" Margin="0,0,8,0">
                        <TextBlock x:Name="PictureName" FontSize="13" Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Style="{StaticResource FloatButton}" Width="36" Height="36" Content="&#xE8E5;" ToolTip="{ui:Localized 'Открыть в программе', 'Open in default app'}" AutomationProperties.Name="{ui:Localized 'Открыть в программе', 'Open in default app'}" Click="PictureOpen_Click"/>
                    <Button Style="{StaticResource FloatButton}" Width="36" Height="36" Content="&#xE838;" Margin="8,0,0,0" ToolTip="{ui:Localized 'Показать в папке', 'Show in folder'}" AutomationProperties.Name="{ui:Localized 'Показать в папке', 'Show in folder'}" Click="PictureReveal_Click"/>
                </StackPanel>
            </Grid>

            <!-- The shadow sits on its own layer so the toast text is not drawn through the effect and stays sharp -->
            <ContentControl x:Name="ToastHost" Style="{StaticResource Flyout}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,8,24,0" Padding="14,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center"/>
                    <Button x:Name="ToastAction" Height="28" Margin="12,0,0,0" Visibility="Collapsed" Click="ToastAction_Click"/>
                </StackPanel>
            </ContentControl>

            <Grid x:Name="FlyoutLayer" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" MouseDown="FlyoutLayer_MouseDown" KeyboardNavigation.TabNavigation="Cycle">
                <Grid.Resources>
                    <!-- Trash rows: menu-like hover; the row actions show on hover or keyboard focus and stay reachable with Tab -->
                    <Style x:Key="TrashRow" TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Padding" Value="8,6,4,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Surface3}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="TrashActions" TargetType="StackPanel">
                        <Setter Property="Orientation" Value="Horizontal"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <ContentControl x:Name="TrashCard" Style="{StaticResource Flyout}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="380" Padding="8">
                    <DockPanel x:Name="TrashPanel"/>
                </ContentControl>
                <ContentControl x:Name="UsageCard" Style="{StaticResource Flyout}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="344" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="UsagePanel" Margin="8,4"/>
                    </ScrollViewer>
                </ContentControl>
            </Grid>

            <Grid x:Name="SearchLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="30" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Search_PreviewKeyDown">
                <Image x:Name="SearchBlur" Stretch="Fill" IsHitTestVisible="False">
                    <Image.Effect><BlurEffect Radius="12" RenderingBias="Performance"/></Image.Effect>
                </Image>
                <Border Background="#45000000" MouseLeftButtonDown="SearchBackdrop_Click"/>
                <Grid Margin="24">
                    <Border MaxWidth="760" Height="500" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" VerticalAlignment="Center" Background="{DynamicResource SearchGlass}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,0,12,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static ui:Glyphs.Cancel}" AutomationProperties.Name="{ui:Localized 'Закрыть поиск', 'Close search'}" Click="SearchClose_Click"/>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE721;" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextMuted}"/>
                                    <Grid>
                                        <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FontSize="15" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="{ui:Localized 'Поиск в Sharp Agent', 'Search Sharp Agent'}"/>
                                        <TextBlock x:Name="SearchHint" Text="{ui:Localized 'Поиск в Sharp Agent', 'Search Sharp Agent'}" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="15"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="6,8,6,4">
                                <ListBox x:Name="SearchResults" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseLeftButtonUp="SearchResults_MouseLeftButtonUp" AutomationProperties.Name="{ui:Localized 'Результаты поиска', 'Search results'}">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="10,8,10,5"/></DataTemplate></GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Row" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
                                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Fill}"/></Trigger>
                                                            <DataTrigger Binding="{Binding Path}" Value="new"><Setter TargetName="Row" Property="Background" Value="Transparent"/></DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Snippet}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="SearchStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
                            </Grid>
                            <DockPanel Grid.Row="2" Margin="10,4,10,10">
                                <TextBlock x:Name="SearchLimitHint" DockPanel.Dock="Bottom" Text="{ui:Localized 'Показана часть результатов. Уточните запрос.', 'Some results were omitted. Refine your search.'}" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="8,8,8,0"/>
                                <WrapPanel x:Name="SearchFilters"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Border x:Name="DialogDim" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="40" Visibility="Collapsed" Background="{DynamicResource Backdrop}"/>
        </Grid>
    </Border>
</Window>
