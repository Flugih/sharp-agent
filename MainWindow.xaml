                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border x:Name="TookenPanel" Style="{StaticResource SettingsRow}">
                                        <StackPanel>
                                            <TextBlock Text="{ui:Localized 'Адрес API', 'API address'}"/>
                                            <TextBox x:Name="BaseUrlBox" TextChanged="ConnectionFieldChanged" Style="{StaticResource FieldTextBox}" Margin="0,8,0,0" AutomationProperties.Name="{ui:Localized 'Адрес API', 'API address'}"/>
