<Application x:Class="SharpAgent.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SharpAgent.Ui">
    <Application.Resources>
        <ui:PillRadiusConverter x:Key="PillRadius"/>

        <SolidColorBrush x:Key="Bg" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="Surface" Color="#242427"/>
        <SolidColorBrush x:Key="Surface2" Color="#2C2C30"/>
        <SolidColorBrush x:Key="Surface3" Color="#37373C"/>
        <SolidColorBrush x:Key="Line" Color="#2F2F33"/>
        <SolidColorBrush x:Key="LineStrong" Color="#3E3E44"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#74747C"/>
        <SolidColorBrush x:Key="LineHover" Color="#8E8E96"/>
        <SolidColorBrush x:Key="Text" Color="#ECECEE"/>
        <SolidColorBrush x:Key="TextSoft" Color="#C9C9CE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A0A0A7"/>
        <SolidColorBrush x:Key="TextFaint" Color="#6E6E76"/>
        <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="UserBubble" Color="#173B70"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1F3447"/>
        <SolidColorBrush x:Key="AccentLine" Color="#12527F"/>
        <SolidColorBrush x:Key="AccentText" Color="#7CC0F2"/>
        <SolidColorBrush x:Key="BannerBg" Color="#192937"/>
        <SolidColorBrush x:Key="Danger" Color="#D13438"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#341C1F"/>
        <SolidColorBrush x:Key="DangerLine" Color="#5E2A2E"/>
        <SolidColorBrush x:Key="DangerText" Color="#FF9592"/>
        <SolidColorBrush x:Key="Success" Color="#4CC38A"/>
        <SolidColorBrush x:Key="Warning" Color="#F2B84B"/>
        <SolidColorBrush x:Key="WarningSoft" Color="#33290F"/>
        <SolidColorBrush x:Key="WarningLine" Color="#5C4A17"/>
        <SolidColorBrush x:Key="Backdrop" Color="#C4101012"/>
        <SolidColorBrush x:Key="Shade" Color="#8C000000"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#161618"/>
        <SolidColorBrush x:Key="DiffAdd" Color="#16351F"/>
        <SolidColorBrush x:Key="DiffRemove" Color="#401C21"/>
        <SolidColorBrush x:Key="HoverLight" Color="White"/>
        <SolidColorBrush x:Key="HoverDark" Color="Black"/>
        <SolidColorBrush x:Key="CaptionHover" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="CaptionPressed" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="CaptionCloseHover" Color="#C42B1C"/>
        <SolidColorBrush x:Key="CaptionClosePressed" Color="#B3271A"/>
        <SolidColorBrush x:Key="CompactBg" Color="#F01E1F22"/>
        <SolidColorBrush x:Key="CompactLine" Color="#54FFFFFF"/>
        <SolidColorBrush x:Key="CompactDivider" Color="#38FFFFFF"/>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <Geometry x:Key="SharpMark">M6,2 V14 M10,2 V14 M2.6,6.5 L13.4,4.3 M2.6,11.7 L13.4,9.5</Geometry>

        <ControlTemplate x:Key="FocusPillTemplate">
            <Border Margin="-3" BorderBrush="{DynamicResource Text}" BorderThickness="2" SnapsToDevicePixels="True" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"/>
        </ControlTemplate>
        <Style x:Key="FocusPill">
            <Setter Property="Control.Template" Value="{StaticResource FocusPillTemplate}"/>
        </Style>
        <ControlTemplate x:Key="FocusRectTemplate">
            <Border Margin="-3" BorderBrush="{DynamicResource Text}" BorderThickness="2" CornerRadius="10" SnapsToDevicePixels="True"/>
        </ControlTemplate>
        <Style x:Key="FocusRect">
            <Setter Property="Control.Template" Value="{StaticResource FocusRectTemplate}"/>
        </Style>
        <ControlTemplate x:Key="FocusInnerTemplate">
            <Border Margin="1" BorderBrush="{DynamicResource Text}" BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True"/>
        </ControlTemplate>
        <Style x:Key="FocusInner">
            <Setter Property="Control.Template" Value="{StaticResource FocusInnerTemplate}"/>
        </Style>

        <ControlTemplate x:Key="RoundTemplate" TargetType="ButtonBase">
            <Grid x:Name="Root">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PillRadius}}"/>
                <Border x:Name="Hover" Background="{DynamicResource HoverLight}" Opacity="0" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PillRadius}}"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="accent">
                    <Setter TargetName="Hover" Property="Background" Value="{DynamicResource HoverDark}"/>
                </Trigger>
                <Trigger Property="Tag" Value="danger">
                    <Setter TargetName="Hover" Property="Background" Value="{DynamicResource HoverDark}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Hover" Property="Opacity" Value="0.18"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="RoundBase" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusPill}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template" Value="{StaticResource RoundTemplate}"/>
        </Style>

        <Style x:Key="PillBase" TargetType="ButtonBase" BasedOn="{StaticResource RoundBase}">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource PillBase}">
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PillButton}"/>

        <Style x:Key="AccentPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Tag" Value="accent"/>
        </Style>

        <Style x:Key="ChatGptPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Tag" Value="danger"/>
        </Style>

        <Style x:Key="StatePillButton" TargetType="Button" BasedOn="{StaticResource RoundBase}">
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="IconBase" TargetType="ButtonBase" BasedOn="{StaticResource RoundBase}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource IconBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="CaptionTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHover}"/>
                </Trigger>
                <Trigger Property="Tag" Value="hover">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionPressed}"/>
                </Trigger>
                <Trigger Property="Tag" Value="pressed">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionPressed}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template" Value="{StaticResource CaptionTemplate}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="CaptionCloseTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseHover}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionClosePressed}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template" Value="{StaticResource CaptionCloseTemplate}"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource IconBase}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="Tag" Value="accent"/>
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource SendButton}">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Tag" Value="{x:Null}"/>
        </Style>

        <DropShadowEffect x:Key="FloatShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="Black"/>
        <Style x:Key="FloatButton" TargetType="Button" BasedOn="{StaticResource IconBase}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource FloatShadow}"/>
        </Style>

        <Style x:Key="PillToggle" TargetType="ToggleButton" BasedOn="{StaticResource PillBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <ControlTemplate x:Key="FileChipTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="FileChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRect}"/>
            <Setter Property="Template" Value="{StaticResource FileChipTemplate}"/>
        </Style>

        <ControlTemplate x:Key="FileCardTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="FileCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="14,10,12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRect}"/>
            <Setter Property="Template" Value="{StaticResource FileCardTemplate}"/>
        </Style>

        <ControlTemplate x:Key="RowTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="current">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusInner}"/>
            <Setter Property="Template" Value="{StaticResource RowTemplate}"/>
        </Style>

        <ControlTemplate x:Key="ProgressHeaderTemplate" TargetType="ToggleButton">
            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="3,4">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Surface2}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="ProgressTemplate" TargetType="Expander">
            <StackPanel>
                <ToggleButton x:Name="HeaderSite" HorizontalAlignment="Left" Background="Transparent" FocusVisualStyle="{StaticResource FocusInner}" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" ToolTip="{TemplateBinding ToolTip}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ProgressHeaderTemplate}">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter ContentSource="Header"/>
                        <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="7,0,2,0" Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                </ToggleButton>
                <ui:RevealPanel IsOpen="{TemplateBinding IsExpanded}">
                    <ContentPresenter/>
                </ui:RevealPanel>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ProgressSection" TargetType="Expander">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Template" Value="{StaticResource ProgressTemplate}"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ChatItem" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <ControlTemplate x:Key="MenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,0,12,0" MinHeight="30" MinWidth="190" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{DynamicResource TextMuted}"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="MenuItem">
            <EventSetter Event="RequestBringIntoView" Handler="MenuItem_RequestBringIntoView"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template" Value="{StaticResource MenuItemTemplate}"/>
        </Style>
        <Style x:Key="CommandItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </Style>

        <ContextMenu x:Key="EditMenu">
            <MenuItem Header="Вырезать" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" Style="{StaticResource CommandItem}"/>
            <MenuItem Header="Копировать" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" Style="{StaticResource CommandItem}"/>
            <MenuItem Header="Вставить" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" Style="{StaticResource CommandItem}"/>
            <Separator/>
            <MenuItem Header="Выделить всё" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" Style="{StaticResource CommandItem}"/>
        </ContextMenu>
        <ContextMenu x:Key="ReadOnlyTextMenu">
            <MenuItem Header="Копировать" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" Style="{StaticResource CommandItem}"/>
            <MenuItem Header="Выделить всё" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" Style="{StaticResource CommandItem}"/>
        </ContextMenu>
        <ContextMenu x:Key="PasteOnlyMenu">
            <MenuItem Header="Вставить" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" Style="{StaticResource CommandItem}"/>
        </ContextMenu>

        <Style x:Key="ComposerInput" TargetType="ui:ComposerBox">
            <Setter Property="ContextMenu" Value="{StaticResource EditMenu}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <DataTemplate x:Key="ModelPickerContent">
            <DockPanel Margin="12,0">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="12" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="ModelPicker" TargetType="Button" BasedOn="{StaticResource PillBase}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContentTemplate" Value="{StaticResource ModelPickerContent}"/>
        </Style>

        <ControlTemplate x:Key="ThumbTemplate" TargetType="Thumb">
            <Border Background="{DynamicResource ControlBorder}" CornerRadius="3"/>
        </ControlTemplate>
        <ControlTemplate x:Key="VScrollTemplate" TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                    <Thumb Template="{StaticResource ThumbTemplate}" Margin="3,2" MinHeight="24"/>
                </Track.Thumb>
            </Track>
        </ControlTemplate>
        <ControlTemplate x:Key="HScrollTemplate" TargetType="ScrollBar">
            <Track x:Name="PART_Track">
                <Track.Thumb>
                    <Thumb Template="{StaticResource ThumbTemplate}" Margin="2,3"/>
                </Track.Thumb>
            </Track>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template" Value="{StaticResource VScrollTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource HScrollTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineHover}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                </Trigger>
                <Trigger Property="Tag" Value="invalid">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerText}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="ContextMenu" Value="{StaticResource EditMenu}"/>
        </Style>
        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource Field}">
            <Setter Property="ContextMenu" Value="{StaticResource PasteOnlyMenu}"/>
            <Setter Property="PasswordChar" Value="•"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,16,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusInner}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="MeterTemplate" TargetType="ProgressBar">
            <Grid>
                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>
        </ControlTemplate>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template" Value="{StaticResource MeterTemplate}"/>
        </Style>

        <ControlTemplate x:Key="ToolTipTemplate" TargetType="ToolTip">
            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="4" Padding="8,5">
                <ContentPresenter>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </Border>
        </ControlTemplate>
        <Style TargetType="ToolTip">
            <Setter Property="ui:PopupPlacement.InWindow" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="Template" Value="{StaticResource ToolTipTemplate}"/>
        </Style>

        <ControlTemplate x:Key="MenuTemplate" TargetType="ContextMenu">
            <Border Margin="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </ScrollViewer>
            </Border>
        </ControlTemplate>
        <Style TargetType="ContextMenu">
            <Setter Property="ui:PopupPlacement.InWindow" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="Template" Value="{StaticResource MenuTemplate}"/>
        </Style>

        <ControlTemplate x:Key="EffortMenuTemplate" TargetType="ContextMenu">
            <Border Margin="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </ScrollViewer>
            </Border>
        </ControlTemplate>
        <Style x:Key="EffortPickerMenu" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
            <Setter Property="Width" Value="272"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
            <Setter Property="Template" Value="{StaticResource EffortMenuTemplate}"/>
        </Style>

        <ControlTemplate x:Key="EffortHeaderTemplate" TargetType="MenuItem">
            <ContentPresenter ContentSource="Header"/>
        </ControlTemplate>
        <Style x:Key="EffortHeader" TargetType="MenuItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="StaysOpenOnClick" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template" Value="{StaticResource EffortHeaderTemplate}"/>
        </Style>

        <ControlTemplate x:Key="EffortTrackButton" TargetType="RepeatButton">
            <Border Background="Transparent"/>
        </ControlTemplate>
        <ControlTemplate x:Key="EffortThumbTemplate" TargetType="Thumb">
            <Ellipse Fill="White"/>
        </ControlTemplate>
        <ControlTemplate x:Key="EffortSliderTemplate" TargetType="ui:EffortSlider">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" Template="{StaticResource EffortTrackButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Width="28" Height="28" Cursor="Hand" Template="{StaticResource EffortThumbTemplate}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" Template="{StaticResource EffortTrackButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </ControlTemplate>
        <Style x:Key="EffortSlider" TargetType="ui:EffortSlider">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource LineStrong}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusPill}"/>
            <Setter Property="Template" Value="{StaticResource EffortSliderTemplate}"/>
        </Style>

        <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        <Style x:Key="Flyout" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource FlyoutShadow}"/>
        </Style>

        <ControlTemplate x:Key="SeparatorTemplate" TargetType="Separator">
            <Border Height="1" Margin="4" Background="{DynamicResource LineStrong}"/>
        </ControlTemplate>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template" Value="{StaticResource SeparatorTemplate}"/>
        </Style>
    </Application.Resources>
</Application>
